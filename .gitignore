# The working workbook and its exports stay off a PUBLIC repo - they hold the
# inventory, what each box cost and what it sold for.
Card Run HQ - Master.xlsx
Card Run HQ - Master (*).xlsx
Card Run HQ - Master.new.xlsx
ebay-upload-*.csv
ebay-template.csv

# Excel's lock file, dropped beside a workbook it has open. inuse.py looks for
# it; it should never be committed.
~$*.xlsx

# Scan staging: pages waiting to be cut up, and crops not yet identified or
# filed onto a SKU. photos/ itself is kept -- that is where filed card
# pictures live.
photos/scans/
photos/crops/

__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# A day's price check leaves two things behind: a running log of what moved,
# and every figure it read. Both are about YOUR cards and what they cost.
price_history.csv
price-check.log
daily-update.log

# A batch of photos being worked through: the converted copies and the contact
# sheets are scratch, and the JSON holds which card each shot is.
photos/_batch/
batch-photos.json
